# ============================================================================
# GEESP-Angola: Environment Configuration Template
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git (it contains sensitive information)
#
# REQUIRED variables (startup will warn if unset):
#   GEE_JSON_KEY      — path to Google Earth Engine credentials JSON
#   GEESP_API_KEY     — API key for protecting backend endpoints
#   GEESP_ENVIRONMENT — 'development' | 'staging' | 'production'
# ============================================================================

# ============================================================================
# GOOGLE EARTH ENGINE CONFIGURATION
# ============================================================================

# Google Earth Engine API key/credentials path
# Either set GEE_JSON_KEY to path of credentials.json, or use gee auth
GEE_JSON_KEY=./credentials/gee-key.json

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application environment (development, staging, production) — REQUIRED
APP_ENV=development
GEESP_ENVIRONMENT=development

# Application debug mode
DEBUG=False

# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION (if using external database)
# ============================================================================

# Database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./geesp_data.db

# Database pool size
DATABASE_POOL_SIZE=5

# ============================================================================
# API CONFIGURATION
# ============================================================================

# FastAPI host and port (if using API server)
API_HOST=0.0.0.0
API_PORT=8000

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# Optional API key for backend endpoint protection (X-API-Key or Authorization: Bearer <key>)
GEESP_API_KEY=

# Allowed origins for CORS (comma-separated)
GEESP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Enable API documentation
API_DOCS_ENABLED=True

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

# Streamlit app port
STREAMLIT_PORT=8501

# Streamlit server address
STREAMLIT_SERVER_ADDRESS=localhost

# Enable Streamlit logger
STREAMLIT_LOGGER_LEVEL=info

# ============================================================================
# DATA STORAGE CONFIGURATION
# ============================================================================

# Local data directory
DATA_DIR=./data

# Cache directory for temporary files
CACHE_DIR=./data/cache

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# Sentry error tracking (optional)
SENTRY_DSN=

# AWS S3 configuration (for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================

# Enable remote logging
REMOTE_LOGGING_ENABLED=False

# Logging service URL (e.g., for Grafana Loki)
LOGGING_SERVICE_URL=

# ============================================================================
# OPTIONAL: SECURITY
# ============================================================================

# API secret key for authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe())")
API_SECRET_KEY=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================================================
# OPTIONAL: EMAIL CONFIGURATION (for notifications)
# ============================================================================

# SMTP server configuration
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Email recipients for alerts
ALERT_EMAIL=
