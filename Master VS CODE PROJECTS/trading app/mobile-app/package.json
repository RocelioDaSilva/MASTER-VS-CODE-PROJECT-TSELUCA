{
  "name": "buscador-mobile",
  "version": "1.0.0",
  "description": "App mobile para buscar ofertas e demandas",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build --platform android",
    "build-local": "expo prebuild --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.5.14",
    "@react-navigation/native": "^6.1.9",
    "axios": "^1.6.2",
    "expo": "^48.0.0",
    "expo-status-bar": "~1.12.1",
    "moment": "^2.29.4",
    "react": "18.2.0",
    "react-native": "^0.71.8",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0"
  },
  "private": true
}
