# MongoDB Configuration
# Substitua SEU_USUARIO e SUA_SENHA pelas credenciais do MongoDB Atlas
# Exemplo: mongodb+srv://user123:senha456@cluster0.abcd1234.mongodb.net/intermediario
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster0.xxxxx.mongodb.net/intermediario

# Database name
DB_NAME=intermediario

# Node environment
NODE_ENV=production
